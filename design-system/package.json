{
  "name": "@tanndalen-orsa/design-system",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:css": "node scripts/generate-css-vars.mjs",
    "generate:typography": "node scripts/generate-typography-css.mjs",
    "verify:font-size-rem": "node scripts/verify-font-size-rem.mjs",
    "tokens:css": "npm run generate:css && npm run generate:typography && npm run verify:font-size-rem",
