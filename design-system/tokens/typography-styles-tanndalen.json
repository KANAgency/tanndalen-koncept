{
  "$html-implementation": "Klasser följer Figma-namn: .td-heading-xxl, .td-body-xl, .td-annotation. Gamla namn är alias.",
  "$description": "Text styles för Figma/CSS (TD). Speglad Figma TD 2026-10-21.",
  "$figma-groups": {
    "Heading": ["heading-xxl", "heading-xl", "heading-lg", "heading-md", "heading-sm", "heading-xs", "heading-xxs", "heading-xxxs"],
    "Editorial": ["annotation", "body-xl", "body-lg", "body", "body-sm", "eyebrow", "eyebrow-sm", "quote", "quote-sm", "quote-xs", "statement"],
    "UI": ["ui-title", "ui-title-lg", "ui-title-sm", "ui-body", "ui-body-sm", "ui-caption", "ui-kicker", "ui-label", "ui-nav", "ui-cta", "ui-cta-sm", "ui-figure", "ui-figure-lg", "ui-figure-md", "ui-figure-sm", "ui-figure-sm-regular", "ui-figure-unit", "ui-figure-unit-lg", "ui-figure-unit-md"]
  },
  "$naming": "leading är enhetslös multiplikator när den är ett tal. tracking är em (px / fontstorlek, tre decimaler).",
  "$weights": "Regular=400. Book=450. Bold=700.",

  "heading-xxl": { "family": "TD.primary", "size": "7xl", "weight": "bold", "leading": 1.1, "tracking": -0.04, "mobile": { "size": "4xl", "tracking": -0.021 } },
  "heading-xxl-regular": { "family": "TD.primary", "size": "7xl", "weight": "regular", "leading": 1.1, "tracking": -0.04, "mobile": { "size": "4xl", "tracking": -0.021 } },
  "heading-xl": { "family": "TD.primary", "size": "5xl", "weight": "bold", "leading": 1.1, "tracking": -0.04, "mobile": { "size": "3xl", "tracking": -0.019 } },
  "heading-xl-regular": { "family": "TD.primary", "size": "5xl", "weight": "regular", "leading": 1.1, "tracking": -0.04, "mobile": { "size": "3xl", "tracking": -0.019 } },
  "heading-lg": { "family": "TD.primary", "size": "4xl", "weight": "bold", "leading": 1.1, "tracking": -0.04, "mobile": { "size": "2xl", "tracking": -0.02 } },
  "heading-lg-regular": { "family": "TD.primary", "size": "4xl", "weight": "regular", "leading": 1.1, "tracking": -0.04, "mobile": { "size": "2xl", "tracking": -0.02 } },
  "heading-md": { "family": "TD.primary", "size": "3xl", "weight": "bold", "leading": 1.15, "tracking": -0.028, "mobile": { "size": "xl", "tracking": -0.021 } },
  "heading-md-regular": { "family": "TD.primary", "size": "3xl", "weight": "regular", "leading": 1.15, "tracking": -0.028, "mobile": { "size": "xl", "tracking": -0.021 } },
  "heading-sm": { "family": "TD.primary", "size": "32", "weight": "bold", "leading": 1.15, "tracking": -0.019, "mobile": { "size": "2xl", "tracking": -0.02 } },
  "heading-sm-regular": { "family": "TD.primary", "size": "32", "weight": "regular", "leading": 1.15, "tracking": -0.019, "mobile": { "size": "2xl", "tracking": -0.02 } },
  "heading-xs": { "family": "TD.primary", "size": "xl", "weight": "bold", "leading": 1.2, "tracking": -0.021 },
  "heading-xs-regular": { "family": "TD.primary", "size": "xl", "weight": "regular", "leading": 1.2, "tracking": -0.021 },
  "heading-xxs": { "family": "TD.primary", "size": "lg", "weight": "bold", "leading": 1.3, "tracking": -0.02, "mobile": { "size": "md", "tracking": -0.022 } },
  "heading-xxs-regular": { "family": "TD.primary", "size": "lg", "weight": "regular", "leading": 1.3, "tracking": -0.02, "mobile": { "size": "md", "tracking": -0.022 } },
  "heading-xxxs": { "family": "TD.primary", "size": "base", "weight": "bold", "leading": 1.4, "tracking": -0.013 },
  "heading-xxxs-regular": { "family": "TD.primary", "size": "base", "weight": "regular", "leading": 1.4, "tracking": -0.013 },
  "heading-1": { "alias": "heading-xxl" },
  "heading-2": { "alias": "heading-xl" },
  "heading-2-hero": {
    "family": "TD.primary",
    "size": "6xl",
    "weight": "bold",
    "leading": 1.1,
    "tracking": -0.056,
    "note": "Kod-only. Cap = font/size/6xl (72px). Tracking −4px / 72px."
  },
  "heading-3": { "alias": "heading-lg" },
  "heading-4": { "alias": "heading-md" },
  "heading-5": { "alias": "heading-xs-regular" },
  "heading-6": { "alias": "heading-xxs-regular" },
  "eyebrow": {
    "group": "Editorial",
    "family": "TD.secondary",
    "size": "lg",
    "weight": "bold",
    "leading": "relaxed",
    "tracking": "normal",
    "textCase": "uppercase"
  },
  "eyebrow-sm": {
    "group": "Editorial",
    "family": "TD.secondary",
    "size": "md",
    "weight": "bold",
    "leading": "relaxed",
    "tracking": "normal",
    "textCase": "uppercase"
  },
  "annotation": {
    "family": "TD.primary",
    "size": "base",
    "weight": "regular",
    "leading": 1.5,
    "tracking": -0.031,
    "mobile": { "tracking": -0.019 },
    "note": "Figma Editorial/annotation. Radhöjd 24/16."
  },
  "intro": { "alias": "annotation" },
  "body-xl": {
    "family": "TD.secondary",
    "size": "xl",
    "weight": "book",
    "leading": 1.4,
    "tracking": 0,
    "mobile": { "size": "lg" },
    "note": "Figma Editorial/body-xl. 24/140 %."
  },
  "lead": { "alias": "body-xl" },
  "body-lg": { "family": "TD.secondary", "size": "lg", "weight": "book", "leading": 1.5, "tracking": 0, "note": "Figma Editorial/body-lg. 20/150 %. Ingen mobilvariabel i Figma." },
  "body": { "family": "TD.secondary", "size": "md", "weight": "book", "leading": 1.55, "tracking": 0, "mobile": { "size": "base" }, "note": "Figma Editorial/body. 18/155 %." },
  "lead-sm": { "alias": "body" },
  "body-sm": { "family": "TD.secondary", "size": "base", "weight": "book", "leading": 1.6, "tracking": 0, "note": "Figma Editorial/body-sm. 16/160 %." },
  "statement": {
    "family": "TD.secondary",
    "size": "56",
    "weight": "book",
    "leading": 1.18,
    "tracking": 0,
    "mobile": { "size": "32" },
    "note": "Figma Editorial/statement. 56/1.18, teckenavstånd 0. Mobil editorial-statement/size 32."
  },
  "quote": {
    "family": "TD.primary",
    "size": "2xl",
    "weight": "regular",
    "leading": 1.4,
    "tracking": -0.017,
    "mobile": { "size": "xl", "tracking": -0.017 },
    "note": "Figma Editorial/quote är Superclarendon Regular."
  },
  "quote-sm": {
    "family": "TD.primary",
    "size": "xl",
    "weight": "regular",
    "leading": 1.4,
    "tracking": -0.021,
    "mobile": { "size": "lg", "tracking": -0.02 }
  },
  "quote-xs": { "family": "TD.primary", "size": "lg", "weight": "regular", "leading": 1.4, "tracking": -0.025 },
  "ui-title": {
    "group": "UI",
    "family": "TD.secondary",
    "size": "lg",
    "weight": "bold",
    "leading": 1.3,
    "tracking": 0,
    "mobile": { "size": "md" },
    "note": "Figma UI/title. 20 px, radhöjd 26 px."
  },
  "ui-title-lg": {
    "group": "UI",
    "family": "TD.secondary",
    "size": "xl",
    "weight": "bold",
    "leading": 1.3,
    "tracking": 0,
    "mobile": { "size": "lg" },
    "note": "Figma UI/title-lg. 24 px, radhöjd 31.2 px."
  },
  "ui-title-sm": {
    "group": "UI",
    "family": "TD.secondary",
    "size": "base",
    "weight": "bold",
    "leading": 1.3,
    "tracking": 0,
    "note": "Figma UI/title-sm. 16 px, radhöjd 20.8 px."
  },
  "ui-body": { "group": "UI", "family": "TD.secondary", "size": "base", "weight": "book", "leading": 1.5, "tracking": 0, "note": "Figma UI/body. 16/150 %." },
  "ui-body-sm": { "group": "UI", "family": "TD.secondary", "size": "sm", "weight": "book", "leading": 1.5, "tracking": 0, "note": "Figma UI/body-sm. 14/150 %." },
  "ui-caption": { "group": "UI", "family": "TD.secondary", "size": "xs", "weight": "book", "leading": 1.5, "tracking": 0 },
  "ui-kicker": { "group": "UI", "family": "TD.secondary", "size": "xs", "weight": "bold", "leading": 1.333, "tracking": 0 },
  "ui-label": { "group": "UI", "family": "TD.secondary", "size": "xs", "weight": "bold", "leading": 1.083, "tracking": 0 },
  "ui-nav": { "group": "UI", "family": "TD.secondary", "size": "sm", "weight": "book", "leading": 1.071, "tracking": 0 },
  "ui-cta": { "group": "UI", "family": "TD.secondary", "size": "base", "weight": "bold", "leading": 1.1, "tracking": 0 },
  "ui-cta-sm": { "group": "UI", "family": "TD.secondary", "size": "sm", "weight": "bold", "leading": 1.071, "tracking": 0 },
  "ui-figure": { "group": "UI", "family": "TD.primary", "size": "md", "weight": "bold", "leading": 1.111, "tracking": -0.022 },
  "ui-figure-lg": { "group": "UI", "family": "TD.primary", "size": "4xl", "weight": "bold", "leading": 1.083, "tracking": -0.04, "mobile": { "size": "3xl", "tracking": -0.017 } },
  "ui-figure-md": { "group": "UI", "family": "TD.primary", "size": "2xl", "weight": "bold", "leading": 1.1, "tracking": -0.02 },
  "ui-figure-sm": { "group": "UI", "family": "TD.primary", "size": "sm", "weight": "bold", "leading": 1.071, "tracking": -0.029 },
  "ui-figure-sm-regular": { "group": "UI", "family": "TD.primary", "size": "sm", "weight": "regular", "leading": 1.071, "tracking": 0 },
  "ui-figure-unit": { "group": "UI", "family": "TD.primary", "size": "xs", "weight": "bold", "leading": 1.083, "tracking": -0.017 },
  "ui-figure-unit-lg": { "group": "UI", "family": "TD.primary", "size": "xl", "weight": "bold", "leading": 1.083, "tracking": -0.021, "mobile": { "size": "lg", "tracking": -0.015 } },
  "ui-figure-unit-md": { "group": "UI", "family": "TD.primary", "size": "base", "weight": "bold", "leading": 1.125, "tracking": -0.019, "mobile": { "size": "sm", "tracking": -0.021 } }
}
