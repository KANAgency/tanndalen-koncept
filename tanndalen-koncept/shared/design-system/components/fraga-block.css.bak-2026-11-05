/* Fråga / Block (2363:16904) + Rad (2362:16883) + Fält (2362:16902).
   Desktop speglar Figma. Mobil är PROVISORISK — ingen ritning finns; John ritar senare. */

.td-fraga-block {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-lg);
  width: 100%;
  max-width: 845px;
  margin-inline: auto;
  padding: var(--space-3xl) var(--space-3xl) var(--space-5xl);
  border: 1px solid rgb(255 255 255 / 0.7);
  border-radius: var(--radius-md);
  background: rgb(255 255 255 / 0.3);
  backdrop-filter: blur(5px); /* Figma 10 → CSS 5 */
  -webkit-backdrop-filter: blur(5px);
  box-shadow: 0 8px 24px rgb(36 38 41 / 0.06); /* Figma y8 r24, 6% #242629 */
}

.td-fraga-block-overrubrik {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-md);
  width: 100%;
}

.td-fraga-block-overrubrik-icon {
  display: block;
  width: 48px;
  height: 48px;
}

.td-fraga-block-overrubrik-label {
  margin: 0;
  font-family: var(--font-family-TD-secondary), sans-serif;
  font-size: var(--eyebrow-xs-size);
  font-weight: var(--font-weight-bold, 700);
  line-height: var(--eyebrow-xs-line-height);
  letter-spacing: var(--eyebrow-xs-letter-spacing);
  text-transform: uppercase;
  color: var(--color-TD-neutral-strong);
  text-align: center;
}

.td-fraga-block-innehall {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-3xl);
  width: 100%;
  max-width: 627px;
}

.td-fraga-block-rubrikgrupp {
  display: flex;
  flex-direction: column;
  gap: var(--space-xl);
  width: 100%;
  text-align: center;
  color: var(--color-text-primary);
}

.td-fraga-block-rubrik,
.td-fraga-block-ingress {
  margin: 0;
  color: inherit;
}

/* Lokal override — rör inte global .td-heading-lg (−0.04em ≈ −1.92 px).
   Figma Heading/lg: letter-spacing −1.9 px. Med Superclarendon-Bold-06.ttf
   i demot blir radbrytningen tre rader vid −1.9/−0.04em; −2 px ger Figmas
   två rader (52.8×2 ≈ 106). Orsak: se RAPPORT.md (fontfil/metrics). */
.td-fraga-block-rubrik {
  letter-spacing: -2px; /* Figma −1.9 px; lokal −2 px för samma wrap */
}

/* Fråga / Fält */
.td-fraga-falt {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  width: 100%;
  height: 64px;
  /* höger = uppe/nere (md); vänster kvar 2xl för texten */
  padding: var(--space-md) var(--space-md) var(--space-md) var(--space-2xl);
  border: 0;
  border-radius: var(--radius-full);
  background: var(--color-TD-snow);
  color: var(--color-text-primary);
  cursor: text;
}

.td-fraga-falt:focus-within,
.td-fraga-falt:active,
.td-fraga-falt-submit:focus,
.td-fraga-falt-submit:focus-visible,
.td-fraga-falt-submit:active {
  outline: none;
  box-shadow: none;
}

/* Editorial/body explicit — input ärver inte font (och font:inherit
   raderade tidigare .td-lead-sm). */
.td-fraga-falt-input {
  flex: 1;
  min-width: 0;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  font-family: var(--font-family-TD-secondary), sans-serif;
  font-size: var(--font-size-md); /* 18 */
  font-weight: var(--font-weight-book, 450);
  line-height: 1.55;
  letter-spacing: 0;
  color: var(--color-text-primary); /* #24272A */
}

/* Ingen fokus-outline på input (sidans .page :focus-visible annars). */
.td-fraga-falt-input:focus,
.td-fraga-falt-input:focus-visible,
.td-fraga-falt-input:active {
  outline: none;
  outline-offset: 0;
  box-shadow: none;
}

.td-fraga-falt-input::placeholder {
  color: var(--color-TD-neutral); /* #686868 */
  opacity: 1;
}

/* Secondary winter — samma pil som .fraga-send i öppna Fråga-panelen. */
.td-fraga-falt-submit {
  flex: none;
  display: grid;
  width: 40px;
  min-width: 40px;
  height: 40px;
  padding: 0;
  place-items: center;
}

.td-fraga-falt-submit svg {
  display: block;
  width: 16px;
  height: 16px;
}

/* Hover på fält: samma night-overlay som knappar */
.td-fraga-falt {
  position: relative;
  overflow: hidden;
}

.td-fraga-falt::before {
  content: "";
  position: absolute;
  inset: 0;
  background: var(--color-TD-night);
  opacity: 0;
  pointer-events: none;
  border-radius: inherit;
  transition: opacity var(--motion-duration-fast) var(--motion-easing-out-soft);
}

.td-fraga-falt:hover::before {
  opacity: 0.04;
  transition-duration: var(--motion-duration-normal);
}

.td-fraga-falt > * {
  position: relative;
  z-index: 1;
}

/* Frågelistan: se fraga-fragelista.css (.td-fraga-fragelista*). */

/* —— PROVISORISK mobil (ingen Figma-ritning). ——
   Bryter vid 1023 (= sajtens huvudbrytpunkt), inte 767 där Aktuellt-korten
   går till mobilayout. Skiljer sig medvetet tills John ritar Block-mobil. */
@media (max-width: 1023px) {
  .td-fraga-block {
    /* provisional-mobile — ej speglad från Figma */
    max-width: none;
    margin-inline: 0;
    padding: var(--space-2xl) var(--space-lg) var(--space-3xl);
  }

  .td-fraga-block-innehall {
    max-width: none;
  }

  .td-fraga-block .td-fraga-fragelista {
    max-width: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .td-fraga-falt::before {
    transition: none;
  }
}
