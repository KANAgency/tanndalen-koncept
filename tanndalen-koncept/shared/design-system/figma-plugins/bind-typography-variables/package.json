{
  "name": "figma-bind-typography-variables",
  "private": true,
  "scripts": {
    "build": "esbuild src/code.ts --bundle --outfile=code.js --loader:.html=text --target=es2017",
    "build:remote": "esbuild src/remote-sync.ts --bundle --format=iife --global-name=__designSystemSync --outfile=remote-sync.bundle.js --target=es2017",
    "build:all": "npm run build && npm run build:remote",
    "watch": "esbuild src/code.ts --bundle --outfile=code.js --loader:.html=text --target=es2017 --watch"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.109.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2"
  }
}
