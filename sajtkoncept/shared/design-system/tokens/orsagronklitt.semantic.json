    "just-nu-period-dark": { "ref": "color.OG.season-winter" },
    "just-nu-question-icon-0": { "value": "#456972" },
    "just-nu-snow-accent": { "ref": "color.OG.accent" },
    "booking-bar-surface": { "value": "rgba(255, 255, 255, 0)", "note": "snow med opacitet 0." },
    "booking-bar-elevation-color": { "value": "rgba(0, 0, 0, 0)" },
    "booking-calendar-surface": { "ref": "color.OG.snow" },
    "booking-calendar-surface-dark": { "ref": "color.OG.night" },
    "booking-calendar-text": { "ref": "color.OG.night" },
    "booking-calendar-text-dark": { "ref": "color.OG.snow" },
    "booking-calendar-muted": { "ref": "color.OG.neutral-strong" },
    "booking-calendar-muted-dark": { "ref": "color.OG.neutral-subtle" },
    "booking-calendar-disabled": { "ref": "color.OG.neutral-muted" },
    "booking-calendar-disabled-dark": { "ref": "color.OG.neutral-muted" },
    "booking-calendar-range": { "ref": "color.OG.day" },
    "booking-calendar-range-dark": { "ref": "color.OG.neutral-strong" },
    "booking-calendar-selected": { "ref": "color.OG.cta" },
    "booking-calendar-selected-dark": { "ref": "color.OG.cta" },
    "booking-calendar-on-selected": { "ref": "color.OG.snow" },
    "booking-calendar-on-selected-dark": { "ref": "color.OG.snow" },
    "booking-calendar-focus": { "ref": "color.OG.cta" },
    "booking-calendar-focus-dark": { "ref": "color.OG.snow" }
  },

  "difficulty": {
    "green": { "ref": "color.OG.difficulty-green" },
    "green-dark": { "ref": "color.OG.difficulty-green" },
    "blue": { "ref": "color.OG.difficulty-blue" },
    "blue-dark": { "ref": "color.OG.difficulty-blue" },
    "red": { "ref": "color.OG.difficulty-red" },
    "red-dark": { "ref": "color.OG.difficulty-red" },
    "black": { "ref": "color.OG.difficulty-black" },
    "black-dark": { "ref": "color.OG.difficulty-black" },
    "orange": { "ref": "color.OG.difficulty-orange" },
    "orange-dark": { "ref": "color.OG.difficulty-orange" }
  },

  "wax": {
    "$figma": "Semantic COLOR wax-{green|blue|violet|red|yellow}. Alias till Shared / Primitives wax/* — CSS --wax-*. Ingen -dark: vallakortet renderas alltid på snow.",
    "green": { "ref": "color.wax.green" },
    "blue": { "ref": "color.wax.blue" },
    "violet": { "ref": "color.wax.violet" },
    "red": { "ref": "color.wax.red" },
    "yellow": { "ref": "color.wax.yellow" }
  },

  "status": {
    "$figma": "Semantic COLOR status-* — samma struktur som TD, OG-primitiver.",
    "open": { "ref": "color.status.success" },
    "open-dark": { "ref": "color.status.success-dark" },
    "limited": { "ref": "color.status.warning" },
    "limited-dark": { "ref": "color.status.warning-dark" },
    "closed": { "ref": "color.OG.neutral-strong" },
    "closed-dark": { "ref": "color.OG.neutral-muted" },
    "error": { "ref": "color.shared.error" },
    "error-dark": { "ref": "color.status.error-dark" }
  },

  "contrast": {
    "$figma": "Semantic COLOR contrast/on-* — samma struktur som TD, OG-primitiver.",
    "on-accent": { "ref": "color.OG.day" },
    "on-cta": { "ref": "color.OG.snow" },
    "on-cta-on-dark": { "ref": "color.OG.cta" },
    "on-day": { "ref": "color.OG.night" },
    "on-night": { "ref": "color.OG.day" },
    "on-season-autumn": { "ref": "color.OG.day" },
    "on-season-spring": { "ref": "color.OG.night" },
    "on-season-summer": { "ref": "color.OG.day" },
    "on-season-winter": { "ref": "color.OG.night" },
    "on-snow": { "ref": "color.OG.night" }
  },

  "typography": {
    "font-heading": { "ref": "font.family.OG.primary", "status": "Låst — redan i produktion" },
    "font-body": { "ref": "font.family.OG.secondary", "status": "Låst — redan i produktion" },
    "styles": { "ref-file": "typography-styles-orsagronklitt.json", "note": "Elva färdiga text styles, se separat fil" },
    "heading-treatment": { "note": "Öppnare kerning, generösare radavstånd, lägre vikt än Tänndalen. Utnyttja Literatas opsz-axel." }
  },

  "$open-questions": [
    "Hover/active/tonal/cta-on-dark fortfarande PLACEHOLDER — härledda förslag i uppdragets rapport.",
    "Ny hero-copy för att undvika manualens felaktiga färgtabell (VIT/SVART fel funktionsbeskrivning)"
  ]
}
