{
  "$description": "Semantiska roller för Orsa Grönklitt. Pekar in i primitives.json — ändra aldrig värden här.",
  "$status": "Färg: samma struktur/alias som TD, pekar på OG-primitiver (beslut 2026-11-10). Typografi: låst, redan i produktion.",

  "color": {
    "bg-base": { "ref": "color.OG.day" },
    "bg-inverted": { "ref": "color.OG.night" },
    "bg-overlay": {
      "ref": "color.OG.night",
      "alpha": 0.55,
      "status": "decided",
      "role": "scrim",
      "note": "Scrim = night (orsa-black) @ 55% alfa — samma mönster som TD (night = bg-inverted)."
    },
    "frost": {
      "value": "rgba(255, 255, 255, 0.12)",
      "note": "Samma struktur som TD: ren rgba (snow @ 12 %), ingen alias."
    },
    "frost-hover": {
      "value": "rgba(255, 255, 255, 0.2)",
      "note": "Samma struktur som TD: ren rgba (snow @ 20 %)."
    },
    "frost-active": {
      "value": "rgba(255, 255, 255, 0.28)",
      "note": "Samma struktur som TD: ren rgba (snow @ 28 %)."
    },
    "text-primary": { "ref": "color.OG.night" },
    "text-inverted": { "ref": "color.OG.snow" },
    "cta-primary": { "ref": "color.OG.cta", "note": "cta = signal-orange." },
    "cta-on-dark": {
      "ref": "color.OG.snow",
      "note": "Samma aliasmönster som TD (cta-on-dark → snow). Primitiven color.OG.cta-on-dark är fortfarande PLACEHOLDER."
    },
    "accent": { "ref": "color.OG.accent", "note": "accent = signal-orange." },
    "error": { "ref": "color.shared.error", "note": "Systemfärg, identisk med TD." },
    "on-error": { "ref": "color.shared.on-error", "note": "Text på error. Identisk med TD." },
    "season-spring": { "ref": "color.OG.season-spring" },
    "season-summer": { "ref": "color.OG.season-summer" },
    "season-autumn": { "ref": "color.OG.season-autumn" },
    "season-winter": {
      "ref": "color.OG.season-winter",
      "note": "OG = TD-värde tills vidare."
    },
    "bg-surface": { "ref": "color.OG.snow" },
    "bg-base-dark": { "ref": "color.OG.night" },
    "text-primary-dark": { "ref": "color.OG.snow" },
    "just-nu-pager-inactive": { "ref": "color.OG.neutral-subtle" },
    "just-nu-pager-inactive-dark": { "ref": "color.OG.neutral-strong" },
    "just-nu-overlay-transparent": { "value": "rgba(60, 60, 59, 0)" },
